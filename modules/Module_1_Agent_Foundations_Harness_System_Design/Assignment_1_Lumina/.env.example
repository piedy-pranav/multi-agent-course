# LUMINA — copy to .env and fill in. .env is git-ignored; never commit real keys.
# Both services read this file from the repo root.

# ---------- MongoDB Atlas (documents, memory, cache, jobs, vectors, GridFS) ----------
# Atlas free tier (M0) is enough for two weeks. A local mongod has no Vector Search:
# see VECTOR_BACKEND below.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=lumina

# atlas-vector-search (default) | mongo-cosine-scan (local mongod fallback, /health must say so)
VECTOR_BACKEND=atlas-vector-search

# ---------- LLM ----------
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=

# ---------- Search (swappable with no code change) ----------
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
SERPAPI_API_KEY=
SEARCH_CACHE_TTL_SECONDS=21600
# Tier-1 in-process LRU capacity. Not declared anywhere in SPEC/AGENTS/TECHNICAL/DESIGN
# beyond "in-process LRU" — 500 is a documented default (Phase 3 plan D5).
SEARCH_CACHE_LRU_MAX=500

# ---------- OpenAI (embeddings; needed even when the LLM is Anthropic) ----------
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# ---------- Deep search: the expensive gear, so the gates live here ----------
# Sub-questions a plan may hold. Fewer than 3 is a quick search with extra steps.
DEEP_SUB_QUESTIONS_MIN=3
DEEP_SUB_QUESTIONS_MAX=6
# Deep searches per X-User-Id per day. Over cap -> 429 {error, resetsAt}, enforced in the
# agent service. A cap you document but do not enforce is not a cap.
DEEP_DAILY_CAP=5

# ---------- Loop caps (the hard caps from AGENTS.md; do not raise to pass a gate) ----------
MAX_TOOL_CALLS=8
MAX_WALL_CLOCK_SEC=90
# Deep gets a wider envelope because it is doing more, not because it is allowed to sprawl.
MAX_TOOL_CALLS_DEEP=24
MAX_WALL_CLOCK_SEC_DEEP=240

# ---------- Document ingestion & retrieval (Phase 5 D9) ----------
# Chunk size has an UPPER bound on purpose: the whole chunk becomes the citation snippet, and
# the gold set's anchor-matched items only score if the anchor is inside that snippet.
DOC_CHUNK_TARGET_CHARS=1000
DOC_CHUNK_OVERLAP_CHARS=150
# A chunk never splits a source line (that is what keeps locators unique), so a pathologically
# long line is wrapped by the parser first. Every line in the gold corpus is under 100 chars.
DOC_LINE_WRAP_CHARS=400
DOC_EMBED_BATCH_SIZE=64
# Retrieval k's. DOC_FINAL_TOP_K must stay >= 5: the bench slices the emitted document
# sources to 5, and that slice IS the recall@5 measurement.
DOC_VECTOR_TOP_K=20
DOC_TEXT_TOP_K=20
DOC_RRF_K=60
DOC_FINAL_TOP_K=8
# Ceiling on sources one answer may emit. Several searches in one request each contribute
# their fused top-k; keep this above DOC_FINAL_TOP_K so one search is never truncated.
DOC_MAX_SOURCES=12
# Jobs worker. A killed worker leaves its row `running` with a stale claimedAt; the sweeper
# returns it to `pending` once it is this old, and gives up after JOB_MAX_ATTEMPTS so a
# deterministically-broken file cannot cycle forever.
JOB_STALE_AFTER_SECONDS=300
JOB_POLL_INTERVAL_MS=1500
JOB_MAX_ATTEMPTS=3
# Atlas Search is eventually consistent, so a document is only `indexed` after the worker can
# query the vector index and get one of its own chunks back. Observed lag: 0.1-3.7s.
DOC_PROBE_MAX_ATTEMPTS=12
DOC_PROBE_BACKOFF_MS=1500

# ---------- Ports & wiring ----------
PORT_GATEWAY=8787
PORT_AGENT=8000
AGENT_URL=http://localhost:8000
# Comma-separated origins the gateway accepts. Add your Vercel URL before you deploy.
CORS_ORIGINS=http://localhost:5173
# Per-X-User-Id requests/minute at the gateway. 120, not 30: document ingestion status is
# polled (the UI every 1.5s, the bench every 1.2s), so a 30/min ceiling 429s the poll loop
# itself during an upload. The 429 path is unchanged — only the ceiling moved.
RATE_LIMIT_PER_MINUTE=120
LOG_LEVEL=info

# ---------- Web (Vite; only VITE_* reaches the browser — never put a key here) ----------
VITE_API_URL=http://localhost:8787
